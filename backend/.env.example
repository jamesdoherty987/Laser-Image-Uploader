# App
SECRET_KEY=change-me-to-a-long-random-string
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Local SQLite for job metadata (swap for Postgres later if needed)
DATABASE_URL=sqlite:///./laser.db

# Local file storage root (migrate to S3/R2 later via storage backend)
STORAGE_DIR=./uploads
MAX_UPLOAD_BYTES=10485760

# OpenAI Images API (Stage 2+) — never expose to the frontend
OPENAI_API_KEY=
IMAGE_EDIT_MODEL=gpt-image-1
IMAGE_EDIT_PROVIDER=openai

# Desktop connector pairing (Stage 5+)
DESKTOP_PAIRING_TOKEN=
