# App
SECRET_KEY=change-me-to-a-long-random-string
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Local SQLite for job metadata (swap for Postgres later if needed)
DATABASE_URL=sqlite:///./laser.db

# Local file storage root (migrate to S3/R2 later via storage backend)
STORAGE_DIR=./uploads
MAX_UPLOAD_BYTES=10485760

# AI image edit — Gemini Flash Image is cheapest (~$0.039/image). Prefer gemini/auto.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
OPENAI_API_KEY=
IMAGE_EDIT_MODEL=gpt-image-1
# gemini | openai | auto
IMAGE_EDIT_PROVIDER=auto

# Desktop connector pairing (Stage 5+)
DESKTOP_PAIRING_TOKEN=

# Admin console (/admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=galvin-admin
